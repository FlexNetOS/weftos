# WeftOS DevOps Environment Variables
# Copy to .env and populate with your values
# IMPORTANT: Never commit .env to git (it's in .gitignore)
# This file serves as a template for required variables

# ============= WEFTOS MESH CONFIGURATION =============
MESHNET_NODE_ID=dev-node-local
MESHNET_MODE=dev
EXOCHAIN_ATTESTATION_MODE=dual-signature
WEFTOS_GOVERNANCE_CONFIG=constitutional

# ============= MODEL CONFIGURATION =============
# Local model caching
MODEL_CACHE_PATH=./models
MODEL_CACHE_SIZE_GB=20

# Model sources (HuggingFace URLs or local paths)
LLAMA_MODEL_URL=https://huggingface.co/meta-llama/Llama-2-13b-chat-hf
MIXTRAL_MODEL_URL=https://huggingface.co/mistralai/Mixtral-8x7B-Instruct-v0.1

# Default model for inference
DEFAULT_MODEL=llama-2-13b-chat

# ============= SERVICE CONFIGURATION =============
SERVICE_PORT=8080
SERVICE_HOST=127.0.0.1

# Inference settings
INFERENCE_TIMEOUT=60
BATCH_SIZE=4
MAX_CONCURRENT_REQUESTS=4

# ============= LOGGING & MONITORING =============
WEFTOS_LOG_LEVEL=info
WEFTOS_LOG_FORMAT=json
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============= HEALTH CHECK CONFIGURATION =============
HEALTH_CHECK_TIMEOUT=60
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_RETRIES=3

# ============= HARDWARE OPTIMIZATION =============
# These are typically auto-detected by hardware-scan.sh
# Override if needed for specific constraints
FORCE_SMALL_MODELS=0           # Force models <= 7B
REDUCE_PARALLELISM=0           # Limit concurrent processing
DISABLE_CACHE=0                # Disable inference caching
AGGRESSIVE_CLEANUP=0           # Cleanup models after use

# CPU/GPU allocation (optional)
WEFTOS_THREADS=24              # CPU threads (leave some for OS)
WEFTOS_GPU_LAYERS=999          # All layers to GPU if available

# ============= DEPLOYMENT TARGET =============
# Supported: linux-x86_64, aarch64-raspberry-pi, wasm32-wasip1, macos-arm64
DEPLOYMENT_TARGET=linux-x86_64
CI_RUNNER_TYPE=self-hosted

# ============= GITHUB ACTIONS / CI/CD =============
GITHUB_TOKEN=
GITHUB_REPOSITORY=YOUR_USERNAME/weftos
GITHUB_WORKFLOW_ENVIRONMENT=weftos-deployment

# ============= OPTIONAL: REMOTE STORAGE =============
# For distributed deployments or backup
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# HuggingFace Token (for model downloads)
HUGGINGFACE_TOKEN=

# ============= OPTIONAL: OBSERVABILITY =============
# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Loki (logs)
LOKI_URL=http://localhost:3100

# Jaeger (tracing)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============= DEVELOPMENT ONLY =============
# Skip certain checks for rapid iteration
SKIP_SECURITY_AUDIT=0
SKIP_HEALTH_CHECKS=0
SKIP_MODEL_VALIDATION=0
DEBUG_MODE=0
